config TOUCHSCREEN_ST_FTS_V521_SPI_L11A
	tristate "ST/FocalTech FTS v5.2.1 SPI touchscreen (Xiaomi l11a)"
	depends on SPI
	depends on INPUT_TOUCHSCREEN
	help
	  Say Y here for the FocalTech (ST Microelectronics FTS) capacitive
	  touchscreen controller attached over SPI.  This is the panel/touch
	  combination used on the Xiaomi Redmi K50 (rubens), which ships
	  firmware "st_fts_L11a.ftb" (embedded in fts_fw.h).

	  If unsure, say N.
